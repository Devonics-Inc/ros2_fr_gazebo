<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="test_rail_ros2_control" params="name:=test_rail control_system:=moveit">
    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${control_system == 'gazebo'}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:if value="${control_system == 'moveit'}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:if value="${control_system == 'hardware'}">
          <plugin>rail_hardware_interface/RailSystem</plugin>  <!-- your real driver -->
        </xacro:if>
      </hardware>
      <joint name="test_rail_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>