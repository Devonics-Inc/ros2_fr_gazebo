<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="sync_table" params="parent">
    
    <joint name="${parent}_to_table" type="fixed">
      <parent link="${parent}"/>
      <child link="sync_table_base"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="sync_table_base">
      <visual>
        <geometry>
          <mesh filename="package://rail_description/config/sync_table/RolandSyncTable.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://rail_description/config/sync_table/RolandSyncTable.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.001"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0"
                              iyy="0.0001" iyz="0"
                                            izz="0.0001"/>
      </inertial>
    </link>

    <link name="sync_table_carriage"/>

    <joint name="sync_table_joint" type="fixed">
      <parent link="sync_table_base"/>
      <child link="sync_table_carriage"/>
      <origin xyz="0 0 0.865"/>
    </joint>

  </xacro:macro>
</robot>