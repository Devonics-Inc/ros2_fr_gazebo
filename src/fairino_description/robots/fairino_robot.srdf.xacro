<?xml version="1.0" encoding="UTF-8"?>
<robot name="fairino_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="prefix" default=""/>
    <xacro:arg name="mount" default="world"/>
    <xacro:arg name="gripper" default="none"/>
    <xacro:arg name="axes_count" default="1"/>

    <xacro:property name="prefix_arg"  value="$(arg prefix)"/>
    <xacro:property name="mount_arg"  value="$(arg mount)"/>
    <xacro:property name="gripper_arg"  value="$(arg gripper)"/>
    <xacro:property name="num_axes"  value="$(arg axes_count)"/>

    <xacro:property name="chain_base"  value="base_link"/>
    <xacro:property name="chain_end"  value="wrist3_link"/>

    <xacro:macro name="build_joints" params="count">
        <xacro:if value="${count}">
            <xacro:build_joints count="${count - 1}"/>
            <joint name="${mount_arg}_joint_${count}"/>
        </xacro:if>
    </xacro:macro>

    <group name="${prefix_arg}fairino_v6_group">
        <xacro:if value="${mount_arg != 'world'}">
            <xacro:build_joints count="${num_axes}"/>
            <xacro:property name="chain_base"  value="${mount_arg}_base"/>
        </xacro:if>
        <joint name="j1"/>
        <joint name="j2"/>
        <joint name="j3"/>
        <joint name="j4"/>
        <joint name="j5"/>
        <joint name="j6"/>
        <xacro:if value="${gripper_arg != 'none'}">
            <joint name="$(arg gripper)_joint" value="0.0"/>
            <xacro:property name="chain_end"  value="$(arg gripper)_end_link"/>
        </xacro:if>

        <chain base_link="${chain_base}" tip_link="${chain_end}"/>
        
    </group>
    <!--GROUP STATES: Purpose: Define a named state for a particular group, in terms of joint values. This is useful to define states like 'folded arms'-->
    <group_state name="pos1" group="${prefix_arg}fairino_v6_group">

        <joint name="j1" value="2.1093"/>
        <joint name="j2" value="-1.9252"/>
        <joint name="j3" value="1.8901"/>
        <joint name="j4" value="-1.5202"/>
        <joint name="j5" value="-1.4343"/>
        <joint name="j6" value="0"/>
        <xacro:if value="${gripper_arg != 'none'}">
            <joint name="$(arg gripper)_joint" value="0.0"/>
        </xacro:if>
    </group_state>
    <group_state name="pos2" group="${prefix_arg}fairino_v6_group">

        <joint name="j1" value="1.0631"/>
        <joint name="j2" value="-1.6889"/>
        <joint name="j3" value="1.9839"/>
        <joint name="j4" value="-1.8239"/>
        <joint name="j5" value="-1.5018"/>
        <joint name="j6" value="0"/>
        <xacro:if value="${gripper_arg != 'none'}">
            <joint name="$(arg gripper)_joint" value="0.0"/>
        </xacro:if>
    </group_state>
    <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->
    <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="upperarm_link" reason="Never"/>
    <disable_collisions link1="forearm_link" link2="shoulder_link" reason="Never"/>
    <disable_collisions link1="forearm_link" link2="upperarm_link" reason="Adjacent"/>
    <disable_collisions link1="forearm_link" link2="wrist1_link" reason="Adjacent"/>
    <disable_collisions link1="shoulder_link" link2="upperarm_link" reason="Adjacent"/>
    <disable_collisions link1="shoulder_link" link2="wrist1_link" reason="Never"/>
    <disable_collisions link1="upperarm_link" link2="wrist1_link" reason="Never"/>
    <disable_collisions link1="wrist1_link" link2="wrist2_link" reason="Adjacent"/>
    <disable_collisions link1="wrist1_link" link2="wrist3_link" reason="Never"/>
    <disable_collisions link1="wrist2_link" link2="wrist3_link" reason="Adjacent"/>

    <!-- temp-->
    <xacro:if value="${mount_arg != 'world'}">
        <disable_collisions link1="base_link" link2="$(arg mount)_base" reason="Never"/>
        <disable_collisions link1="base_link" link2="$(arg mount)_carriage" reason="Never"/>
        <disable_collisions link1="$(arg mount)_carriage" link2="$(arg mount)_base" reason="Never"/>
    </xacro:if>
    
</robot>
